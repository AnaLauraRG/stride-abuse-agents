# Copiar a infra/.env y completar. infra/.env NUNCA se sube al repositorio.

# Llave con la que n8n cifra las credenciales guardadas (clave de Claude, clave de Supabase).
# Generar con:  openssl rand -hex 32
# Si se pierde, las credenciales guardadas en n8n ya no se pueden descifrar.
N8N_ENCRYPTION_KEY=

# Zona horaria de n8n y de los registros.
TIMEZONE=America/Mexico_City
